# Copiez ce fichier en .env.local et remplissez avec les valeurs de votre
# projet Supabase (Dashboard > Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-clé-anonyme-publique

# ⚠️ SECRET — clé service_role (onglet "Project API keys", ne PAS préfixer
# par NEXT_PUBLIC_, sinon elle serait envoyée au navigateur). Utilisée
# uniquement par app/api/share/route.ts, côté serveur. Sur Vercel, ajoutez-la
# dans Project Settings > Environment Variables, jamais dans du code commité.
SUPABASE_SERVICE_ROLE_KEY=votre-clé-service-role-secrète
